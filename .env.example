# ─────────────────────────────────────────────────────────────
# Empórium da Horta — configuração do ambiente
# Copie este arquivo para `.env` e ajuste o que precisar.
# O `.env` nunca vai para o git: ele guarda senhas e chaves.
# ─────────────────────────────────────────────────────────────

# ── Banco de dados ───────────────────────────────────────────
# Conexão do dia a dia. No Supabase, use a do POOLER (porta 6543).
DATABASE_URL=postgresql://postgres:COLE_A_SENHA_AQUI@localhost:5432/emporium_dev

# Conexão DIRETA, usada só pelas migrações (porta 5432 no Supabase).
# Sem Supabase é a mesma coisa que a de cima e pode ficar vazia.
DIRECT_URL=

# ── Fotos dos produtos ───────────────────────────────────────
# local    → salva na pasta api/uploads e serve pelo próprio Fastify.
# supabase → envia para o Supabase Storage (exige as três chaves abaixo).
STORAGE_DRIVER=local

# Painel do Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=produtos

# ── Fuso da operação ─────────────────────────────────────────
# Decide onde começa "hoje" no painel do dono e na rota do motorista.
# Hospedagem quase sempre roda em UTC; sem isto, o dia da loja começaria às
# 20h do dia anterior. Use um nome IANA (America/Manaus, America/Sao_Paulo…).
FUSO_HORARIO=America/Manaus

# ── Servidor ─────────────────────────────────────────────────
PORT=3333
HOST=127.0.0.1

# Assina os tokens de login da equipe. Em produção, gere uma frase longa e
# aleatória: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-esta-frase-antes-de-colocar-no-ar

# Endereço do site que pode conversar com a API (o front do Vite).
WEB_ORIGIN=http://localhost:5173

# ── Central de distribuição (valor provisório) ───────────────
# De onde o motorista sai. O lugar de verdade para definir isto é o painel do
# dono: Configurações → Central de distribuição, que grava no banco e deixa o
# dono trocar de sede sem mexer em arquivo nenhum.
#
# O que está aqui só vale ENQUANTO ninguém preencheu aquela tela — e, enquanto
# valer, a tela do motorista avisa que os quilômetros e horários do dia estão
# saindo de um endereço inventado.
CENTRAL_NOME=Central de Distribuição
CENTRAL_LATITUDE=-3.1063
CENTRAL_LONGITUDE=-60.0537

# ── Mapa e rota do motorista ─────────────────────────────────
# Em que degrau a rota COMEÇA. Falhando, ela desce sozinha até o de baixo e
# avisa na tela do motorista em qual parou.
#
# tomtom     → trânsito em tempo real, ordem otimizada e curva a curva.
#              RECOMENDADO. Plano gratuito, sem cartão, uso comercial
#              permitido. Crie a conta e pegue a chave em:
#              https://developer.tomtom.com/
# google     → também tem trânsito, mas exige cadastro de cobrança.
# osrm       → rota pelas ruas, sem trânsito. Grátis e sem chave.
# linha-reta → só a heurística do vizinho mais próximo (plano B automático
#              quando o serviço não responde).
ROTA_PROVEDOR=osrm

# Chave da TomTom. Com ela preenchida e ROTA_PROVEDOR=tomtom, a rota do dia e a
# navegação do motorista passam a considerar trânsito. Sem ela, o sistema não
# quebra: cai para o OSRM sozinho e avisa na tela.
TOMTOM_API_KEY=

# Servidor de rotas. O endereço abaixo é a DEMO PÚBLICA do OSRM: serve para
# desenvolver, mas não tem garantia de disponibilidade e não deve ser usada em
# produção. Para valer, suba o seu: https://github.com/Project-OSRM/osrm-backend
OSRM_URL=https://router.project-osrm.org

# Transforma o endereço digitado em coordenada. `nominatim` é o serviço do
# OpenStreetMap: gratuito, com limite de 1 consulta por segundo (respeitado
# pelo código). Use `nenhum` para desligar e cair sempre no centro do bairro.
GEO_PROVEDOR=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Os dois serviços acima exigem que a aplicação se identifique. Ponha aqui um
# contato real antes de colocar no ar — é a regra de uso deles.
CONTATO_APP=Emporium da Horta (contato@emporiumdahorta.com.br)

# ── Acesso inicial da equipe (usado só pelo `npm run db:seed`) ──
DONO_EMAIL=dono@emporiumdahorta.com.br
DONO_SENHA=horta123
MOTORISTA_EMAIL=motorista@emporiumdahorta.com.br
MOTORISTA_SENHA=rota123

# ── Rota do motorista ────────────────────────────────────────
# google     → ordem e previsão COM TRÂNSITO (Routes API). Exige a chave abaixo.
# osrm       → pelas ruas, sem trânsito. Grátis, sem chave, sem cadastro.
# linha-reta → só a heurística, sem falar com serviço nenhum.
#
# A queda é automática: google -> osrm -> linha reta. Se a chave faltar ou a
# cota estourar, a tela continua funcionando e avisa em que degrau parou.

# Console do Google Cloud -> APIs e serviços -> Credenciais.
# ANTES de usar, limite a cota diária da Routes API (Cotas -> editar). Com a
# cota limitada, estourar vira erro, não fatura.
GOOGLE_MAPS_API_KEY=
